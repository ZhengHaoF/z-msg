{
  "name": "z-msg",
  "version": "2.0.0",
  "private": true,
  "description": "端到端加密聊天：Vue 3 前端 + Node.js WebSocket 服务端",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "node server/src/index.js",
    "typecheck": "npm run typecheck -w web",
    "test": "npm run test -w server && npm run test -w web",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC"
}
